# HTTP Server Port
PORT=8080

# Path to the agy CLI binary (defaults to searching PATH or ~/.local/bin/agy)
AGY_BIN=agy

# Path to Antigravity CLI data directory (defaults to ~/.gemini/antigravity-cli)
AGY_DATA_DIR=~/.gemini/antigravity-cli

# Default workspace directory when none is provided in the chat request
AGY_DEFAULT_WORKSPACE=/Users/dika/Documents/github/akalin-ai

# Default permission mode for remote execution: skip-permissions | auto | accept-edits | plan
AGY_DEFAULT_PERMISSION_MODE=skip-permissions

# Allowed CORS origins (comma-separated or *)
AGY_CORS_ORIGINS=*

# ---------------------------------------------------------------------------
# Telegram Bot Configuration (Optional)
# ---------------------------------------------------------------------------
# Set to true to enable the Telegram Bot alongside the HTTP API
TELEGRAM_ENABLED=false

# Bot token from @BotFather on Telegram (looks like 123456789:ABCdef...)
TELEGRAM_BOT_TOKEN=

# Authorized Telegram user IDs (comma-separated numeric IDs from @userinfobot)
# If left empty, all users who message the bot are allowed.
TELEGRAM_ALLOWED_USER_IDS=

